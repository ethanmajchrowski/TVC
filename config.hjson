            x: 0.0
            y: -21.59
        }

        velocity_mps: {
            x: 0.0
            y: 0.0
        }

        rotation_deg: 0.0
        angular_velocity_dps: 0.0
    }

    tvc: {
        max_angle_deg: 10.0
        servo_rate_deg_per_sec: 15.0

        initial_angle_deg: 0.0
        target_angle_deg: 0.0
    }

    motor: {
        thrust_curve: "thrust_curve_E.csv"

        # Optional override for testing.
        override_thrust_curve: false
        static_thrust_n: 100.0
    }

    # not implemented
    launch: {
        rail_length_m: 1.8
        launch_angle_deg: 0.0
    }

    # not implemented
    control: {
        kp: 1.0
        ki: 0.0
        kd: 0.0
    }
    
    # not implemented
